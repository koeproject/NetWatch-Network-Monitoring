# backend/.env.example — copy to backend/.env and fill in. Never commit .env.
ENGINE_URL=http://127.0.0.1:8080
# Provisioning/admin token only. Users -> API tokens in the engine UI.
# The running backend does not need it (docker-compose.dev.yml blanks it).
ENGINE_TOKEN=

# Our store. Local tests/demo: sqlite. In the dev container STORE_URL is set by
# docker-compose.dev.yml from ACME_DB_PASSWORD.
STORE_URL=sqlite:///./acme-store.db
# Password for role acme_app (ops/init-store.sh and docker-compose.dev.yml).
ACME_DB_PASSWORD=

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PUSH_TOKEN=
SESSION_SECRET=
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=

# Local uvicorn over plain http only. Leave unset (true) anywhere else.
COOKIE_SECURE=false

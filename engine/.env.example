# engine/.env.example — copy to engine/.env and fill in. Never commit .env.
#
# Generate the password, do not type one by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# These are read only when the db volume is created. Changing them later does
# NOT change the password inside an existing database.

POSTGRES_USER=zabbix
POSTGRES_PASSWORD=
POSTGRES_DB=zabbix

# for server 
ZBX_STARTCONNECTORS=2
ZBX_TIMEOUT=10

# for web
ZBX_WEB_HOST_PORT=8080
ZBX_SERVER_NAME=NetWatch engine
PHP_TZ=Asia/Bangkok